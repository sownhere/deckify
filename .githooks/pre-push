#!/usr/bin/env bash
set -euo pipefail

protected_branches="main"

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  for protected in $protected_branches; do
    if [[ "$branch" == "$protected" ]]; then
      if [[ "${ALLOW_PROTECTED_PUSH:-}" != "1" ]]; then
        echo "pre-push: direct push to '$protected' is blocked. Open a pull request instead." >&2
        echo "pre-push: to override in an emergency, run: ALLOW_PROTECTED_PUSH=1 git push ..." >&2
        exit 1
      fi
    fi
  done
done

exit 0
